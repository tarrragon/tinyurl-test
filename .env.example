# 複製成 .env 後修改，.env 不進版控

POSTGRES_DB=tinyurl
POSTGRES_USER=tinyurl
POSTGRES_PASSWORD=change-me

# 由哪一套 migration 對資料庫執行 DDL：laravel 或 go，另一個後端啟動時不跑 migration
# 見 infra/postgres/README.md〈誰管 schema〉
SCHEMA_OWNER=laravel

# JWT 簽章金鑰，Go 與 Laravel 共用；用 `openssl rand -base64 48` 產生
JWT_SECRET=change-me

# Laravel 的加密金鑰（cookie、加密欄位），格式是 base64: 前綴加 32 bytes 的 base64；
# 用 `echo "base64:$(openssl rand -base64 32)"` 產生
APP_KEY=change-me

# 網域：短網址只做轉址，前後台與 API 在 APP_DOMAIN
# 瀏覽器會把 *.localhost 解析到本機；curl、k6 等工具不一定會，需要時加進 /etc/hosts
SHORT_DOMAIN=s.localhost
APP_DOMAIN=app.localhost

# 對外的 HTTP port
NGINX_PORT=8080

# Gatus 健康狀態儀表板的對外 port，見 infra/monitoring/README.md
GATUS_PORT=8090
