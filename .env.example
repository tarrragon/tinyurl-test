# 複製成 .env 後修改，.env 不進版控

POSTGRES_DB=tinyurl
POSTGRES_USER=tinyurl
POSTGRES_PASSWORD=change-me

# JWT 簽章金鑰，Go 與 Laravel 共用；用 `openssl rand -base64 48` 產生
JWT_SECRET=change-me

# 網域：短網址只做轉址，前後台與 API 在 APP_DOMAIN
# 瀏覽器會把 *.localhost 解析到本機；curl、k6 等工具不一定會，需要時加進 /etc/hosts
SHORT_DOMAIN=s.localhost
APP_DOMAIN=app.localhost

# 對外的 HTTP port
NGINX_PORT=8080
